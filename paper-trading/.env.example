# Copy to .env (gitignored) and fill in. Never commit the real file.

# Absolute path to your Obsidian vault (the folder that contains .obsidian/)
# macOS example: /Users/you/Documents/MyVault
OBSIDIAN_VAULT_PATH=

# Alpaca paper-trading keys: https://app.alpaca.markets → Paper account → API Keys
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Free plan uses the IEX feed. Set to "sip" if you have a paid data plan.
APCA_DATA_FEED=iex

# Optional fallback if Alpaca fails or rate-limits: https://finnhub.io/register (free tier)
FINNHUB_API_KEY=

# Optional overrides
# PTRADE_GBPUSD=1.34                 # fix the GBP/USD rate instead of fetching it
# PTRADE_DATA_DIR=                   # keep the ledger somewhere other than the vault
# PTRADE_OFFLINE_PRICES=sample/offline-prices.json   # demo mode, no keys needed
